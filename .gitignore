# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
# Compiled output and build artefacts
debug/
target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging info
*.pdb

# NOTE: Cargo.lock is deliberately tracked. This crate ships a binary
# (`camlink`), so reproducible builds outweigh minimal diffs.

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
# Byte-compiled / optimised bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build output
*.egg-info/
.eggs/
dist/
build/
*.whl

# Compiled extension modules — maturin writes into .venv, but catch strays
*.so
*.pyd

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pytype/
.hypothesis/

# Local environment files and secrets
.env
.env.*
!.env.example

# Local interpreter pins
.python-version

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
